{
  "name": "Terraform for Data Engineering",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",
  "features": {
    "ghcr.io/devcontainers/features/terraform:1": { "version": "latest", "tflint": "latest" },
    "ghcr.io/devcontainers/features/aws-cli:1": {},
    "ghcr.io/devcontainers/features/python:1": { "version": "3.12" },
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  "hostRequirements": { "cpus": 2 },
  "secrets": {
    "LOCALSTACK_AUTH_TOKEN": {
      "description": "Free LocalStack Hobby token. Only needed from Day 3. Leave empty for now.",
      "documentationUrl": "https://app.localstack.cloud"
    }
  },
  "forwardPorts": [4566],
  "portsAttributes": { "4566": { "label": "LocalStack (fake AWS)", "onAutoForward": "silent" } },
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "customizations": {
    "vscode": {
      "extensions": ["hashicorp.terraform", "ms-python.python", "redhat.vscode-yaml"],
      "settings": {
        "[terraform]": { "editor.formatOnSave": true, "editor.defaultFormatter": "hashicorp.terraform" },
        "terminal.integrated.defaultProfile.linux": "bash"
      }
    },
    "codespaces": { "openFiles": ["README.md", "lessons/01-iac-workflow/main.tf"] }
  }
}
